{
  "manifest_version": 3,
  "name": "Nerd Extension",
  "version": "1.0",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Nerd Extension"
  },
  
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js", "inject.js"],
      "css": ["content.css"]
    }
  ],
  "icons": {
    "16": "nerd.png",
    "32": "nerd.png",
    "48": "nerd.png",
    "128": "nerd.png"
  }
}